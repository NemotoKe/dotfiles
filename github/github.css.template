:root {
  --coolnight-bg: __BACKGROUND__;
  --coolnight-fg: __FOREGROUND__;
  --coolnight-surface: __SURFACE__;
  --coolnight-border: __BORDER__;
  --coolnight-tab-surface: __TAB_SURFACE__;
  --coolnight-muted: __MUTED__;
  --coolnight-green: __ACCENT_GREEN__;
  --coolnight-green-soft: __ACCENT_GREEN_SOFT__;
  --coolnight-blue: __ACCENT_BLUE__;
  --coolnight-pink: __ACCENT_PINK__;
  --coolnight-purple: __ACCENT_PURPLE__;
  --coolnight-success: __SUCCESS__;
  --coolnight-danger: __DANGER__;
  --coolnight-warning: __WARNING__;
  --coolnight-info: __INFO__;
  --coolnight-selection: __SELECTION__;

  /* Keep GitHub's semantic roles while changing their palette. */
  --bgColor-default: var(--coolnight-bg) !important;
  --bgColor-muted: var(--coolnight-surface) !important;
  --bgColor-inset: var(--coolnight-bg) !important;
  --bgColor-neutral-muted: var(--coolnight-surface) !important;
  --fgColor-default: var(--coolnight-fg) !important;
  --fgColor-muted: var(--coolnight-muted) !important;
  --fgColor-accent: var(--coolnight-fg) !important;
  --fgColor-open: var(--coolnight-success) !important;
  --fgColor-closed: var(--coolnight-danger) !important;
  --fgColor-done: var(--coolnight-purple) !important;
  --fgColor-attention: var(--coolnight-warning) !important;
  --borderColor-default: var(--coolnight-border) !important;
  --borderColor-muted: var(--coolnight-border) !important;
  --accent-fg: var(--coolnight-fg) !important;
  --accent-emphasis: var(--coolnight-fg) !important;
  --success-fg: var(--coolnight-success) !important;
  --danger-fg: var(--coolnight-danger) !important;
  --attention-fg: var(--coolnight-warning) !important;
  --done-fg: var(--coolnight-purple) !important;
  --diffBlob-addition-bgColor: var(--coolnight-surface) !important;
  --diffBlob-addition-fgColor: var(--coolnight-green-soft) !important;
  --diffBlob-deletion-bgColor: var(--coolnight-surface) !important;
  --diffBlob-deletion-fgColor: var(--coolnight-danger) !important;
  --underlineNav-borderColor-active: var(--coolnight-pink) !important;
}

html,
body {
  color-scheme: dark !important;
  background-color: var(--coolnight-bg) !important;
  color: var(--coolnight-fg) !important;
}

body,
.markdown-body,
.markdown-body p,
.markdown-body li,
.markdown-body blockquote {
  color: var(--coolnight-fg) !important;
}

a,
.Link--primary,
.markdown-body a {
  color: var(--coolnight-fg) !important;
}

a:hover,
.Link--primary:hover,
.markdown-body a:hover {
  color: var(--coolnight-pink) !important;
}

::selection {
  background: var(--coolnight-selection) !important;
  color: var(--coolnight-bg) !important;
}

.Header,
.AppHeader,
.AppHeader-header,
.gh-header {
  background-color: var(--coolnight-bg) !important;
  border-color: var(--coolnight-border) !important;
}

.Box,
.Box-header,
.Box-row,
.flash,
.Popover-message,
.discussion-timeline-actions,
.timeline-comment {
  background-color: var(--coolnight-bg) !important;
  border-color: var(--coolnight-border) !important;
}

.markdown-body table tr,
.markdown-body table tr:nth-child(2n),
.snippet-clipboard-content,
.highlight,
pre.notranslate {
  --bgColor-muted: var(--coolnight-bg) !important;
  --bgColor-default: var(--coolnight-bg) !important;
  background-color: var(--coolnight-bg) !important;
  border-color: var(--coolnight-border) !important;
}

input,
textarea,
select,
.form-control,
.SelectMenu-modal,
.SelectMenu-list {
  background-color: var(--coolnight-bg) !important;
  color: var(--coolnight-fg) !important;
  border-color: var(--coolnight-border) !important;
}

input:focus,
textarea:focus,
select:focus,
.form-control:focus,
button:focus-visible,
a:focus-visible {
  border-color: var(--coolnight-pink) !important;
  outline-color: var(--coolnight-pink) !important;
  box-shadow: 0 0 0 2px var(--coolnight-pink) !important;
}

.btn,
.Button,
.js-menu-button {
  background-color: var(--coolnight-surface) !important;
  color: var(--coolnight-fg) !important;
  border-color: var(--coolnight-border) !important;
}

.btn-invisible,
.ClipboardButton {
  background-color: transparent !important;
  border-color: transparent !important;
}

.btn:hover,
.Button:hover,
.js-menu-button:hover {
  background-color: var(--coolnight-bg) !important;
  border-color: var(--coolnight-fg) !important;
}

.btn-primary,
.Button--primary {
  background-color: var(--coolnight-surface) !important;
  color: var(--coolnight-fg) !important;
  border-color: var(--coolnight-fg) !important;
}

.UnderlineNav-item.selected,
.UnderlineNav-item[aria-current="page"],
.tabnav-tab.selected,
.reponav-item.selected,
.reponav-item[aria-current="page"] {
  color: var(--coolnight-fg) !important;
  background-color: var(--coolnight-tab-surface) !important;
  border-bottom-color: var(--coolnight-fg) !important;
}

.Counter,
.Label,
.label {
  background-color: var(--coolnight-surface) !important;
  color: var(--coolnight-fg) !important;
  border-color: var(--coolnight-border) !important;
}

.State--open,
.color-fg-open,
.text-green,
.fgColor-open,
.flash-success,
.color-fg-success {
  color: var(--coolnight-success) !important;
  border-color: var(--coolnight-success) !important;
}

.State--closed,
.color-fg-closed,
.text-red,
.fgColor-closed,
.flash-error,
.color-fg-danger {
  color: var(--coolnight-danger) !important;
  border-color: var(--coolnight-danger) !important;
}

.State--merged,
.color-fg-done,
.text-purple,
.fgColor-done {
  color: var(--coolnight-purple) !important;
  border-color: var(--coolnight-purple) !important;
}

.State--draft,
.color-fg-muted,
.text-gray,
.fgColor-muted {
  color: var(--coolnight-muted) !important;
}

.diff-table .blob-code-addition,
.diff-table .blob-code-addition-line,
.blob-code-addition,
.blob-code-addition-line,
.blob-num-addition {
  background-color: var(--coolnight-surface) !important;
  color: var(--coolnight-green-soft) !important;
}

.diff-table .blob-code-deletion,
.diff-table .blob-code-deletion-line,
.blob-code-deletion,
.blob-code-deletion-line,
.blob-num-deletion {
  background-color: var(--coolnight-surface) !important;
  color: var(--coolnight-danger) !important;
}

.pl-c,
.color-fg-muted {
  color: var(--coolnight-muted) !important;
}

.pl-c1,
.pl-cce,
.pl-coc,
.pl-cos {
  color: var(--coolnight-warning) !important;
}

.pl-k,
.pl-kos,
.pl-smi,
.pl-st {
  color: var(--coolnight-purple) !important;
}

.pl-en,
.pl-ent,
.pl-v {
  color: var(--coolnight-blue) !important;
}

.pl-s,
.pl-pds,
.pl-s1,
.pl-s2,
.pl-sr {
  color: var(--coolnight-green-soft) !important;
}

.pl-mb,
.pl-mh,
.pl-mi,
.pl-mp,
.pl-mr,
.pl-mv {
  color: var(--coolnight-pink) !important;
}

.markdown-body pre,
.markdown-body code,
.highlight pre,
.blob-code-inner {
  background-color: var(--coolnight-bg) !important;
  color: var(--coolnight-fg) !important;
}

.markdown-body table th,
.markdown-body table td,
.Box-footer,
.border-top,
.border-bottom,
.UnderlineNav {
  border-color: var(--coolnight-border) !important;
}

.markdown-body hr,
hr {
  background-color: var(--coolnight-border) !important;
}

.js-issue-title,
.gh-header-title,
.markdown-title {
  color: var(--coolnight-fg) !important;
}

.flash-warn,
.color-fg-attention,
.text-yellow {
  color: var(--coolnight-warning) !important;
  border-color: var(--coolnight-warning) !important;
}
